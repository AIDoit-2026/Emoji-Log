{
	"name": "ccimage-emoji-log",
	"displayName": "Emoji Log 2026",
	"description": "Emoji-Log — An Emoji Git commit log messages spec standard. [ 📦👌🐛📖🚀🤖 ‼️ ].",
	"version": "1.5.0",
	"author": {
		"name": "ccimage",
		"email": "ccimage.sj@gmail.com"
	},
	"publisher": "ccimage",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/AIDoit-2026/Emoji-Log"
	},
	"engines": {
		"vscode": "^1.75.0"
	},
	"galleryBanner": {
		"color": "#fad000"
	},
	"keywords": [
		"Emoji Log",
		"Emoji Log VSCode",
		"git",
		"emoji",
		"commit",
		"messages"
	],
	"categories": [
		"Other"
	],
	"icon": "images/icon.png",
	"activationEvents": [
		"onCommand:extension.EmojiLog",
		"onCommand:emojiLog.configureEmojis"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "extension.EmojiLog",
				"title": "Emoji Log: Create Emoji Log git commit message [📦👌🐛📖🚀🤖 ‼️]",
				"icon": {
					"dark": "images/icon_dark.svg",
					"light": "images/icon_light.svg"
				}
			},
			{
				"command": "emojiLog.configureEmojis",
				"title": "Emoji Log: Configure Emojis"
			}
		],
		"keybindings": [
			{
				"command": "emojiLog.configureEmojis",
				"key": "ctrl+alt+e",
				"mac": "cmd+alt+e"
			}
		],
		"configuration": {
			"title": "Emoji Log",
			"properties": {
				"emojiLog.emojis": {
					"type": "array",
					"scope": "application",
					"description": "Commit prefixes shown by Emoji Log, in display order.",
					"uniqueItems": true,
					"items": {
						"type": "object",
						"required": ["prefix", "description"],
						"properties": {
							"prefix": {
								"type": "string",
								"description": "Text inserted at the start of the Git commit message."
							},
							"description": {
								"type": "string",
								"description": "Explanation shown in the emoji picker."
							}
						},
						"additionalProperties": false
					},
					"default": [
						{ "prefix": "📦 NEW:", "description": "Add something entirely new." },
						{ "prefix": "👌 IMPROVE:", "description": "Improve piece of code like refactoring." },
						{ "prefix": "🐛 FIX:", "description": "Fix a bug — need I say more?" },
						{ "prefix": "📖 DOC:", "description": "Anything documentation related." },
						{ "prefix": "🚀 RELEASE:", "description": "Release a new version." },
						{ "prefix": "🤖 TEST:", "description": "Testing related commits." },
						{ "prefix": "‼️ BREAKING:", "description": "Change that breaks previous versions." }
					]
				}
			}
		},
		"menus": {
			"scm/title": [
				{
					"when": "scmProvider == git",
					"command": "extension.EmojiLog",
					"group": "navigation"
				}
			]
		}
	},
	"badges": [
		{
			"url": "https://img.shields.io/badge/SUPPORT%20THIS%20PROJECT-Become%20a%20VSCode%20Power%20User%20%E2%86%92-gray.svg?colorA=131217&colorB=5734F5&style=flat",
			"href": "https://VSCode.pro/?utm_source=EmojiLogVSCode",
			"description": "Support this project!"
		}
	],
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile",
		"test": "node test/repositoryTarget.test.js"
	},
	"devDependencies": {
		"@types/glob": "^8.0.1",
		"@types/mocha": "^10.0.1",
		"@types/node": "^18.13.0",
		"@types/vscode": "^1.75.1",
		"glob": "^8.1.0",
		"mocha": "^10.2.0",
		"tslint": "^6.1.3",
		"typescript": "^4.9.5"
	}
}
